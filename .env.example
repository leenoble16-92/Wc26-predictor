# CALLED IT. — required environment variables (six total).
# Copy to .env.local and fill with real values. NEVER commit .env.local.
# Mirror all six into Vercel → Settings → Environment Variables (Production + Preview).

# --- Supabase --- (NEXT_PUBLIC_* are the only two safe in the client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — only referenced under app/api/cron/ and app/api/admin/.
SUPABASE_SERVICE_ROLE_KEY=

# --- football-data.org v4 (server-only) ---
FOOTBALL_DATA_TOKEN=

# --- App secrets (server-only) ---
CRON_SECRET=
ADMIN_SECRET=
